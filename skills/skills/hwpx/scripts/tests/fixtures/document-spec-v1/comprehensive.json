{
  "version": "1.0",
  "metadata": {
    "title": "DocumentSpec v1 종합 픽스처",
    "author": "hwp-cli",
    "subject": "구조화 HWPX 저작",
    "keywords": "HWPX,DocumentSpec,fixture",
    "description": "섹션, 스타일, 목록, 머리말, 꼬리말, 표, 수식, 필드의 native 저작 회귀"
  },
  "page": {
    "width_mm": 210,
    "height_mm": 297,
    "orientation": "portrait",
    "margin_left_mm": 20,
    "margin_right_mm": 20,
    "margin_top_mm": 18,
    "margin_bottom_mm": 18,
    "margin_header_mm": 10,
    "margin_footer_mm": 10,
    "gutter_mm": 0
  },
  "styles": {
    "body": {
      "font_family": "함초롬바탕",
      "font_size_pt": 10,
      "align": "justify",
      "line_height_percent": 160
    },
    "heading": {
      "based_on": "body",
      "font_family": "함초롬돋움",
      "font_size_pt": 15,
      "bold": true,
      "color": "#112233",
      "spacing_before_pt": 8,
      "spacing_after_pt": 4
    },
    "emphasis": {
      "based_on": "body",
      "bold": true,
      "underline": true,
      "background": "#FFF2CC"
    }
  },
  "lists": {
    "outline": {
      "kind": "ordered",
      "levels": [
        {
          "marker": "{n}.",
          "start": 1,
          "style": "body"
        },
        {
          "marker": "{n})",
          "start": 1,
          "style": "body"
        }
      ]
    },
    "bullet": {
      "kind": "bullet",
      "levels": [
        {
          "marker": "○",
          "style": "body"
        }
      ]
    }
  },
  "sections": [
