    {
      "id": "landscape",
      "page": {
        "width_mm": 297,
        "height_mm": 210,
        "orientation": "landscape",
        "margin_left_mm": 15,
        "margin_right_mm": 15,
        "margin_top_mm": 15,
        "margin_bottom_mm": 15,
        "margin_header_mm": 8,
        "margin_footer_mm": 8,
        "gutter_mm": 0
      },
      "page_number": {
        "position": "outside",
        "format": "decimal",
        "start": 1
