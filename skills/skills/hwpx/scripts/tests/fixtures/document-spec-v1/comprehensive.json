      "id": "main",
      "header": {
        "default": [
          {
            "type": "paragraph",
            "runs": [
              {
                "type": "text",
                "text": "기본 머리말",
                "style": "body"
              }
            ]
          }
        ],
        "odd": [
          {
            "type": "paragraph",
            "runs": [
              {
                "type": "text",
                "text": "홀수 쪽"
              }
            ]
          }
